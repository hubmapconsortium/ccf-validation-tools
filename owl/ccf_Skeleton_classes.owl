        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ethmoidal bulla of ethmoid bone</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ethmoidal bulla of ethmoid bone</skos:prefLabel>
    </owl:Class>
