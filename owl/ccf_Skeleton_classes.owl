    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_1200153"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skeletal element projection constituting the roughened lateral area of the tubercle of the ninth rib that affords attachment for the lateral costotransverse ligament. It faces increasingly posterolaterally compared with upper ribs, reflecting the gradually changing orientation of the costotransverse articulation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN:9780323393225</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Rib</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://fipat.library.dal.ca/ta2/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


