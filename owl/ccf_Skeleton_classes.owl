        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transverse process of coccyx</skos:prefLabel>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transverse process of first cervical vertebra</skos:prefLabel>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transverse process of second cervical vertebra</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/a/a1/Processustransversusvertebrae.PNG</foaf:depiction>
