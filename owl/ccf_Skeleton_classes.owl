        </owl:annotatedTarget>
        <IN_OBO rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True</IN_OBO>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-07-01T10:51:23.138021</dc:date>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_1200050"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zone of bone organ forming the broad, posterolateral convex surface of the ilium of the os coxa (innominate bone), bounded by the iliac crest superiorly and the acetabulum inferiorly, and providing the origin for the three gluteal muscles and the tensor fasciae latae.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN:9780323393225</oboInOwl:hasDbXref>
