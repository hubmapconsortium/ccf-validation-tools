    <!-- http://purl.obolibrary.org/obo/UBERON_1200105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_1200105">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004635"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zone of bone organ forming the inferior demi-facet on the posterolateral body of the eleventh thoracic vertebra. It is present when T11 participates in a shared costal articulation with the head of rib 11 alongside the superior costal facet of T12; however, T11 more typically bears a single complete costal facet for the head of rib 11.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-19T00:00:00+00:00</terms:date>
