        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">submandibular fossa of mandible</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">submandibular fossa of mandible</skos:prefLabel>
