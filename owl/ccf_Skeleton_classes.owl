        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_1200250"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A process of vertebra forming the broad lateral mass of the atlas (C1) on its superior aspect, bearing the kidney-shaped concave facet that receives the occipital condyle to form the atlanto-occipital joint, enabling nodding movements of the head.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN:9780323393225</oboInOwl:hasDbXref>
