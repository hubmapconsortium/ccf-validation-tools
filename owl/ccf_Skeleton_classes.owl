        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dumb-bell-shaped bone of endochondral origin with cartilaginous epiphyses that articulates with tarsal 5 or the distal head of the tibiale-fibulare proximally and with the proximal phalanx of digit V distally.[AAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-20</oboInOwl:date_retrieved>
        <oboInOwl:external_class rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAO:0000929</oboInOwl:external_class>
        <oboInOwl:ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAO</oboInOwl:ontology>
