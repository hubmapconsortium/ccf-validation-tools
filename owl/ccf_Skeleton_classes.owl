    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001454">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005899"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Endochondral tarsal bone articulating with centralia and metatarsal 3.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Small element that articulates anteriorly with metatarsal III. It may be fused to tarsal 2.[AAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In some types, the cuneiform is found as two or three bones, in which case the more anterior (&apos;dorsal&apos; in dorsal/plantar terminology) is the ectocuneiform, while the more posterior or plantar bones are the mesocuneiform and entocuneiform.[Palaeos]</obo:UBPROP_0000005>
