    <!-- http://purl.obolibrary.org/obo/UBERON_1200028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_1200028">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004601"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A surface groove running along the inferior border of the body of the first rib that lodges the intercostal nerve and vessels. In the first rib this groove is less pronounced than in typical ribs because the first rib is nearly horizontal and broad, with its superior surface facing upward rather than medially.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-19T00:00:00+00:00</terms:date>
