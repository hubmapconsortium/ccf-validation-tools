    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000976">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paired endochondral long bone that extends between the pectoral girdle and the skeletal parts of the forelimb. [PHENOSCAPE:mah].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paired, elongate, cylindrical bones of endochondral origin that extend from the pectoral girdle to the elbows.[AAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000003 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Most anatomists now agree that the three proximal bones of the tetrapod limbs are homologous to the two or three proximal elements of the paired fin skeleton of other sarcopterygians, that is the humerus-femur, radius-tibia, and ulna-fibula.[well established][VHOG]</obo:UBPROP_0000003>
        <obo:UBPROP_0000007 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">humeral</obo:UBPROP_0000007>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-9114-8737"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAO:0000679</oboInOwl:hasDbXref>
