        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">iliopubic ramus of os coxa</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">iliopubic ramus of os coxa</skos:prefLabel>
    </owl:Class>
