                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004634"/>
            </owl:Restriction>
        </owl:annotatedTarget>
        <IN_OBO rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True</IN_OBO>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-07-01T10:51:23.137329</dc:date>
    </owl:Axiom>
    <owl:Axiom>
