            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zone of bone organ forming a curved bony ridge on the external surface of the frontal bone, arching above each orbit immediately superior to the supraorbital margin. It overlies the frontal sinus and is more prominent in males.</obo:IAO_0000115>
