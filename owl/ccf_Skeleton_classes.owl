        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">facet of twelfth rib</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">facet of twelfth rib</skos:prefLabel>
    </owl:Class>
