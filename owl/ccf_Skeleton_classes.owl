        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lesser wings of sphenoid bone</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lesser wings of sphenoid bone</skos:prefLabel>
    </owl:Class>
