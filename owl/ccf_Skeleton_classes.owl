    <!-- http://purl.obolibrary.org/obo/UBERON_0006657 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006657">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anatomical cavity for the proximal articular surface of the proximal limb or fin element with the scapulocoracoid or equivalent structure.</obo:IAO_0000115>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cavity for the articulation of the forelimb formed by the scapula, coracoid, and clavicle.[AAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relationship loss: part_of scapular area (AAO:0000935)[AAO]</obo:UBPROP_0000002>
        <obo:UBPROP_0000008 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The glenoid fossa can be associated with the metapterygium in sarcopterygians, or either the meso- or propterygium in basal gnathostomes such as Chondrichthyans</obo:UBPROP_0000008>
        <obo:UBPROP_0000012 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA also has classes for the bony parts around the cavity - these may be more useful than the cavity term itself</obo:UBPROP_0000012>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAO:0000749</oboInOwl:hasDbXref>
