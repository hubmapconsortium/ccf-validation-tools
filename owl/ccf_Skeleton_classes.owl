    <!-- http://purl.obolibrary.org/obo/UBERON_1200221 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_1200221">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0014477"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zone of bone organ encompassing the full extent of the sternum as the flat, elongated bone forming the midline of the anterior thoracic wall, comprising the manubrium, body, and xiphoid process, and providing articular surfaces for the clavicles and costal cartilages of ribs 1–7 as well as attachment for thoracic and abdominal muscles.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
