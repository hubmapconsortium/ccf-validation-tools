    <!-- http://purl.obolibrary.org/obo/UBERON_1200302 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_1200302">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004616"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neural arch forming the posterior bony ring of the seventh cervical vertebra (C7), composed of two pedicles and two laminae; it bears the long non-bifid vertebra prominens spinous process posteriorly, marking the transition to the thoracic spine.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-19T00:00:00+00:00</terms:date>
