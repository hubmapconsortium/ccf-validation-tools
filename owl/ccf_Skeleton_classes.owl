    <!-- http://purl.obolibrary.org/obo/UBERON_1200215 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_1200215">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004602"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zone of bone organ forming the anterior extremity of the second rib that connects to the costal cartilage of the second rib. The second rib is a true rib whose costal cartilage articulates with the sternum at the sternal angle (angle of Louis), the junction between the manubrium and the body of the sternum.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-19T00:00:00+00:00</terms:date>
