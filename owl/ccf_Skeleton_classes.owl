        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">superior articular facet of first thoracic vertebra</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">superior articular facet of first thoracic vertebra</skos:prefLabel>
    </owl:Class>
