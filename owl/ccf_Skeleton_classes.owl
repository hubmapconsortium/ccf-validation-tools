        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mental protuberance of mandible</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mental protuberance of mandible</skos:prefLabel>
    </owl:Class>
