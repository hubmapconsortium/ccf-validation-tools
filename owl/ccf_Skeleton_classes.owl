    <!-- http://purl.obolibrary.org/obo/UBERON_0002396 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002396">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008895"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The triangular flat bone of the nasal septum.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dermal bone that underlies the mesethmoid and inserts in a fossa on the anteroventral surface of the parasphenoid.[TAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paired, palatal bones of intramembranous origin that lie ventral to the olfactory region and help to floor the nasal capsules.[AAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relationship loss: overlaps autopalatine-vomer joint (TAO:0001784)[TAO]</obo:UBPROP_0000002>
        <obo:UBPROP_0000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relationship loss: overlaps mesethmoid-vomer joint (TAO:0001680)[TAO]</obo:UBPROP_0000002>
        <obo:UBPROP_0000003 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In bony fish, the vomers are flattened, paired, bones forming the anterior part of the roof of the mouth, just behind the premaxillary bones. In many species, they have teeth, supplementing those in the jaw proper; in some extinct species the teeth on the vomers were actually larger than the primary set. In amphibians and reptiles, the vomers become narrower, due to the presence of the enlarged choanae (the inner part of the nostrils) on either side, and they may extend further back in the jaw. They are typically small in birds, where they form the upper hind part of the beak, again being located between the choanae. In mammals, the vomers have become narrower still, and are fused into a single, vertically oriented bone. The development of the hard palate beneath the vomer means that the bone is now located in a nasal chamber, separate from the mouth[WP]</obo:UBPROP_0000003>
        <obo:UBPROP_0000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The vomer is paired in some taxa (e.g., Amia) while unpaired in others (e.g., teleosts).[TAO]</obo:UBPROP_0000005>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAO:0000633</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:9710</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MA:0001496</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MESH:D055172</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCIT:C33888</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCTID:272678009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TAO:0000308</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C0242403</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Vomer</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ZFA:0000308</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vomer bone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">prevomer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBERON:0002396</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
