    <!-- http://purl.obolibrary.org/obo/UBERON_1200260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_1200260">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000209"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A bone foramen or notch in the supraorbital margin of the frontal bone, positioned approximately one-third of the way along the margin from its medial end. It transmits the supraorbital nerve and vessels to the forehead and scalp.</obo:IAO_0000115>
