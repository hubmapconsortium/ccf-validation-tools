    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001760">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The frontal sinus occupies the dorsal part of the skull medial to the orbit. It overlaps cranial and nasal cavities and is often referred to as the conchofrontal sinus.</obo:IAO_0000115>
