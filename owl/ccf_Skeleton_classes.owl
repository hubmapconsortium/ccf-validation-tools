    <!-- http://purl.obolibrary.org/obo/UBERON_1200173 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_1200173">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
