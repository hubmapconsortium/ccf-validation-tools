    <!-- http://purl.obolibrary.org/obo/UBERON_1200061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_1200061">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004601"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A surface groove on the superior surface of the first rib, situated anterior to the scalene tubercle, that accommodates the subclavian vein as it crosses the rib. This groove lies medial to the groove for the subclavian artery and is a unique feature of the first rib, reflecting its relationship with the major vessels of the upper limb.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-19T00:00:00+00:00</terms:date>
