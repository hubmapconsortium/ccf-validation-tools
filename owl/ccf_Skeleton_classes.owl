        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">costal notches of sternum</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">costal notches of sternum</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_1200030"/>
