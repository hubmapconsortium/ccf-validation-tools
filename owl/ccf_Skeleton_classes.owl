    <!-- http://purl.obolibrary.org/obo/UBERON_0001682 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001682">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008895"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A paired dermal bone situated in the mid-palate that helps form the hard palate [Palaeos].</obo:IAO_0000115>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_32519"/>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dermal bone that forms the antero-lateral region of the palate and is located ventral to the autopalatine. The dermopalatine is bilaterally paired and usually bears teeth.[TAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dermopalatine: same as palatine. The prefix is used by fish people because the palatine is a dermal replacement bone for a section of the autopalatine section of the palatoquadrate. In that context, palatine is potentially ambiguous.[Palaeos]</obo:UBPROP_0000005>
        <obo:UBPROP_0000005 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In ostariophysans, the dermopalatine is absent.[TAO]</obo:UBPROP_0000005>
        <obo:UBPROP_0000008 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fusion of dermopalatine+autopalatine.</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMAPA:36619</oboInOwl:hasDbXref>
