        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transverse costal facet of third thoracic vertebra</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">transverse costal facet of third thoracic vertebra</skos:prefLabel>
    </owl:Class>
