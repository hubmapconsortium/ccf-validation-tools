                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004630"/>
            </owl:Restriction>
        </owl:annotatedTarget>
        <IN_OBO rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True</IN_OBO>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-07-01T10:51:23.137260</dc:date>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_1200292"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neural arch forming the posterior bony ring of the fifth thoracic vertebra, consisting of pedicles and laminae that together with the body enclose the spinal canal at mid-thoracic level. Its spinous process is long and steeply inclined inferiorly, and the transverse processes project posterolaterally bearing facets for the tubercle of rib 5.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN:9780323393225</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Thoracic_vertebrae</oboInOwl:hasDbXref>
