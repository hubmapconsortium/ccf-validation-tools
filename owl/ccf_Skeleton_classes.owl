        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zone of bone organ forming the broad, posterolateral convex surface of the ilium of the os coxa (innominate bone), bounded by the iliac crest superiorly and the acetabulum inferiorly, and providing the origin for the three gluteal muscles and the tensor fasciae latae.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
