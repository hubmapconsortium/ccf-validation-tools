    <!-- http://purl.obolibrary.org/obo/UBERON_1200249 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_1200249">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004636"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zone of bone organ located on the superior articular process of the twelfth thoracic vertebra, facing posteriorly and oriented in the coronal or slightly oblique plane. It articulates with the inferior articular facet of T11; T12 is markedly transitional and its superior facets retain the thoracic orientation while the inferior facets adopt the lumbar pattern.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-19T00:00:00+00:00</terms:date>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#added_by_HRA"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">superior articular facet of twelfth thoracic vertebra</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">superior articular facet of twelfth thoracic vertebra</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_1200249"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004636"/>
            </owl:Restriction>
        </owl:annotatedTarget>
        <IN_OBO rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True</IN_OBO>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-07-01T10:51:23.138097</dc:date>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_1200249"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zone of bone organ located on the superior articular process of the twelfth thoracic vertebra, facing posteriorly and oriented in the coronal or slightly oblique plane. It articulates with the inferior articular facet of T11; T12 is markedly transitional and its superior facets retain the thoracic orientation while the inferior facets adopt the lumbar pattern.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN:9780323393225</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Thoracic_vertebrae</oboInOwl:hasDbXref>
