        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A bone foramen forming a narrow fissure between the tympanic and squamous parts of the temporal bone at the anterior wall of the mandibular fossa. It transmits the chorda tympani branch of the facial nerve and the anterior tympanic branch of the maxillary artery into the infratemporal fossa.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
