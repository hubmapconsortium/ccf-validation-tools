        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">superior articular facet of third cervical vertebra</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">superior articular facet of third cervical vertebra</skos:prefLabel>
    </owl:Class>
