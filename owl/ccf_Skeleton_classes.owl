        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skeletal element projection extending anteriorly from the squamous part of the temporal bone to articulate with the temporal process of the zygomatic bone, completing the zygomatic arch. Its superior border gives attachment to the temporal fascia, and the masseter muscle attaches to its inferior surface.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
