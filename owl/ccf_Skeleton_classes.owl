    <!-- http://purl.obolibrary.org/obo/UBERON_1200181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_1200181">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001677"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skeletal element projection forming the slender, hook-like inferior tip of the medial pterygoid plate of the sphenoid bone, curving laterally and inferiorly; it serves as a pulley around which the tendon of the tensor veli palatini muscle turns before spreading into the soft palate.</obo:IAO_0000115>
