        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">facet of tenth rib</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">facet of tenth rib</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_1200040"/>
