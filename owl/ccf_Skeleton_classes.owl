        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">groove for subclavian artery of first rib</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">groove for subclavian artery of first rib</skos:prefLabel>
    </owl:Class>
