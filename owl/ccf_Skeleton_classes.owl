                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001678"/>
            </owl:Restriction>
        </owl:annotatedTarget>
        <IN_OBO rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True</IN_OBO>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-07-01T10:51:23.137372</dc:date>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_1200286"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zone of bone organ forming a small canal in the floor of the jugular fossa of the petrous part of the temporal bone, transmitting the tympanic nerve (Jacobson&apos;s nerve), a branch of the glossopharyngeal nerve (CN IX), to the tympanic cavity where it contributes to the tympanic plexus.</owl:annotatedTarget>
