                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004634"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zone of bone organ located on the inferior articular process of the tenth thoracic vertebra, facing anteroinferiorly. It articulates with the superior articular facet of T11 at the zygapophyseal joint; T10 is a transitional vertebra and its inferior facets may begin to adopt a more sagittally oriented profile approaching the lumbar pattern.</obo:IAO_0000115>
