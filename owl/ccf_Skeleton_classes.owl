        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">supramastoid crest of squamous part of temporal bone</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">supramastoid crest of squamous part of temporal bone</skos:prefLabel>
    </owl:Class>
