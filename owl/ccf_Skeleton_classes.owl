    <!-- http://purl.obolibrary.org/obo/UBERON_1200040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_1200040">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004609"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zone of bone organ on the head of the tenth rib that is typically a single articular surface articulating with the body of the tenth thoracic vertebra alone. The tenth rib is transitional: in most individuals its head bears only one facet, though it may occasionally retain a small superior demifacet.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
