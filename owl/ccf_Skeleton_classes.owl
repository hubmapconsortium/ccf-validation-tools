    <!-- http://purl.obolibrary.org/obo/UBERON_1200088 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_1200088">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001092"/>
