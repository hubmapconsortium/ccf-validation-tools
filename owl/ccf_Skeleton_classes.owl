        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">superior costal facet of eleventh thoracic vertebra</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">superior costal facet of eleventh thoracic vertebra</skos:prefLabel>
    </owl:Class>
