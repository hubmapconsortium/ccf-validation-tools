        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Design pattern notes: check whether this fits the foramen design pattern</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foramen magnum</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foramen magnum of basilar part of occipital bone</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/3/39/Gray130.png</foaf:depiction>
