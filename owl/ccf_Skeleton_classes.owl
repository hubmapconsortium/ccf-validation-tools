            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zone of bone organ forming the pair of triangular horizontal plates that project laterally from the anterosuperior aspect of the sphenoid body, lying in the floor of the anterior cranial fossa and forming the roof of the orbit posteriorly; each lesser wing is connected to the body by two roots enclosing the optic canal.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
