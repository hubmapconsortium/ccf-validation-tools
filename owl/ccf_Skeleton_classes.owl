        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001677"/>
            </owl:Restriction>
        </owl:annotatedTarget>
        <IN_OBO rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True</IN_OBO>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-07-01T10:51:23.137040</dc:date>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_1200126"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zone of bone organ forming the pair of triangular horizontal plates that project laterally from the anterosuperior aspect of the sphenoid body, lying in the floor of the anterior cranial fossa and forming the roof of the orbit posteriorly; each lesser wing is connected to the body by two roots enclosing the optic canal.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN:9780323393225</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Sphenoid_bone</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://fipat.library.dal.ca/ta2/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_1200127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_1200127">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003690"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zone of bone organ forming the sacral contribution to the linea terminalis, constituting the posterior arc of the pelvic brim and demarcating the boundary between the greater and lesser pelvis at the level of the sacral promontory and alae.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
