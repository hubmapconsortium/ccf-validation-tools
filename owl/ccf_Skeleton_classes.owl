        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A zone of bone organ forming the posterior vertical plate of the sella turcica on the superior surface of the sphenoid body, bounded above by the posterior clinoid processes; it forms the posterior wall of the hypophyseal fossa and, together with the clivus of the occipital bone, supports the basilar artery and pons.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-7073-9172"/>
