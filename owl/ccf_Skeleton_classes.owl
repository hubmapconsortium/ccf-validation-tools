        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cervical vertebra</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cervical vertebra</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/f/f8/Illu_vertebral_column.jpg</foaf:depiction>
    </owl:Class>
