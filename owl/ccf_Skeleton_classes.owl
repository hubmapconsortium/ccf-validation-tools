        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">linea terminalis of sacrum</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">linea terminalis of sacrum</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
