        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vertebra prominens of seventh cervical vertebra</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vertebra prominens of seventh cervical vertebra</skos:prefLabel>
    </owl:Class>
