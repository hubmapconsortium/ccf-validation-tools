        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hiatus and groove of petrous part of temporal bone for lesser petrosal nerve</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hiatus and groove of petrous part of temporal bone for lesser petrosal nerve</skos:prefLabel>
    </owl:Class>
