        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_1200221"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget>
            <owl:Restriction>
