        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">plexus mesentericus superior</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Superior_mesenteric_plexus</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003011"/>
    </owl:Axiom>
