        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Peritubular capillary endothelial cells feature fenestrations measuring 60-70 nm in diameter, each traversed by a thin diaphragm.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/cl.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peritubular capillary endothelial cell</rdfs:label>
