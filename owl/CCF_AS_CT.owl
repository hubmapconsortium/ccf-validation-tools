    <!-- http://purl.obolibrary.org/obo/UBERON_0001506 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001506">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000188"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The brachialis (brachialis anticus) is a muscle in the upper arm that flexes the elbow joint. It lies just deep of the biceps brachii, and is a synergist that assists the biceps brachii in flexing at the elbow. It makes up part of the floor of the region known as the cubital fossa. [WP,unvetted].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A muscle of the stylopodium, covering the distal half of the humerus and the anterior part of the elbow joint. It functions to flex the zeugopodium. [TFD][VHOG]</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EHDAA2:0000181</oboInOwl:hasDbXref>
