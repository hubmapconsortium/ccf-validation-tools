            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lymphatic vessel that exits the lymph node. The efferent lymphatic vessel commences from the lymph sinuses of the medullary portion of the lymph nodes and leave the lymph nodes either to veins or greater nodes. Efferent lymphatic vessels are also found in the thymus and spleen. This is in contrast to afferent lymphatic vessels, which are found only in lymph nodes.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MA:0000749</oboInOwl:hasDbXref>
