        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fibrocyte of adventitia of ureter</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fibroblast</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_1000308"/>
