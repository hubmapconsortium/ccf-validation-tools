        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The soft tissue that fills the cavities of bones.</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TODO - create superclass for bone marrow / head kidney. both are portions of tissue in the hematopoetic system. also consider adding as subclass of zone of bone organ for consistency with FMA. See also: Leydig and epigonal organs</obo:IAO_0000116>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">consider placement of NCIT:C53466 medullary bone</obo:IAO_0000116>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000003 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The bone marrow is the hematopoietic organ in all vertebrates but fishes, in which hematopoiesis occurs in the kidney.[well established][VHOG]</obo:UBPROP_0000003>
        <obo:UBPROP_0000009 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In adults, marrow in large bones produces new blood cells[Wikipedia:Bone_marrow]</obo:UBPROP_0000009>
