    <!-- http://purl.obolibrary.org/obo/UBERON_0002260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009623"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The ventral roots contain efferent motor axons. Similar to the dorsal roots, the ventral roots continue out from the spinal column, and meet and mix with their corresponding dorsal nerve root at a point after the ganglion.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The efferent motor root of a spinal nerve. At its distal end, the ventral root joins with the dorsal root to form a mixed spinal nerve[Wikipedia:Anterior_root_of_spinal_nerve].</obo:UBPROP_0000001>
        <obo:UBPROP_0000012 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:77516 xref is a &apos;general anatomical term&apos;. We xref both to ensure equivalence.</obo:UBPROP_0000012>
