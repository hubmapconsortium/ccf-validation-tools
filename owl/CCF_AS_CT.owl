        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metatarsal bone of digit 5</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metatarsal bone of digit 5</skos:prefLabel>
    </owl:Class>
