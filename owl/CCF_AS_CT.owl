        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The formal and textual definitions of this term will need to be altered if evidence for non-inhibitory GABA-ergic neurons emerges.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/cl.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GABAergic interneuron</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://cellxgene.cziscience.com/cellguide/CL_0011005</rdfs:seeAlso>
