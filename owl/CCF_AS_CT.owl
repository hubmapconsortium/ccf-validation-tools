        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A transcriptomically distinct GABAergic neuron located in the cerebral cortex that expresses somatostatin (sst) and derived from the MGE.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:27477017</oboInOwl:hasDbXref>
