        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dendritic Cell</skos:prefLabel>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dendritic cell</skos:prefLabel>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dendritic cell</skos:prefLabel>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dendritic cell (DC)</skos:prefLabel>
    </owl:Class>
