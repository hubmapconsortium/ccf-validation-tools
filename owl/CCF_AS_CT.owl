        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dorsal segment of the diencephalon containing the habenular ganglia, a choroid plexus, and the pineal organ.[AAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-06-20</oboInOwl:date_retrieved>
