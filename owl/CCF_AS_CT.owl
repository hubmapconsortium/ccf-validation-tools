    <!-- http://purl.obolibrary.org/obo/CL_4033064 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4033064">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tissue-resident macrophage that is part of the uterus.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6677-8489"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-01-08T16:05:09+00:00</terms:date>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uterine macrophage</oboInOwl:hasBroadSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Uterine macrophages are reported to be evenly distributed throughout the endometrial stroma but with aggregations observed close to the lumen of superficial secretory glands.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/cl.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uterine resident macrophage</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">uterine macrophage</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4033064"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
