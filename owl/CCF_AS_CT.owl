    <!-- http://purl.obolibrary.org/obo/UBERON_0001676 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001676">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
