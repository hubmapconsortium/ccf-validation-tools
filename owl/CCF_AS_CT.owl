        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exocrine system</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exocrine system</skos:prefLabel>
