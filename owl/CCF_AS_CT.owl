        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mesodermal signaling center of the hair follicle consisting of closely packed specialized mesenchymal fibroblasts. Framed by the enlarged bulb matrix in anagen.</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">consider adding grouping class for TAO:0001995 ! papilla</obo:IAO_0000116>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000008 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In humans, at the surface of the skin in hands and feet, they appear as epidermal or papillary ridges (colloquially known as fingerprints)</obo:UBPROP_0000008>
        <obo:UBPROP_0000009 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Blood vessels in the dermal papillae nourish all hair follicles and bring nutrients and oxygen to the lower layers of epidermal cells.</obo:UBPROP_0000009>
        <obo:UBPROP_0000012 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ncit has &apos;hair papilla&apos; as part of hypodermis</obo:UBPROP_0000012>
