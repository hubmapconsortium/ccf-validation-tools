        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">neck of talus</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015180"/>
