        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A layer of the ovarian follicle that consists of theca cells.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000009 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The theca folliculi are responsible for the production of testosterone from androstenedione in females, and indirectly the production of estrogens by supplying the neighboring granulosa cells with androstenedione that can then be used as a substrate for aromatase. [Wikipedia:Theca_of_follicle]</obo:UBPROP_0000009>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BTO:0002853</oboInOwl:hasDbXref>
