    <!-- http://purl.obolibrary.org/obo/UBERON_0001424 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001424">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The major postaxial endochondral bone in the anterior zeugopod[Phenoscape].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One of the two long bones of endochondral origin of the fore-epipodium; it is located on the medial (inner) side of the radius. The upper end of the ulna articulates with the lower end of the humerus forming a strong hinge joint with the carpals, whereas the lower articulates with the carpals.[AAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000007 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ulnar</obo:UBPROP_0000007>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAO:0000789</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMAPA:19104</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:23466</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">GAID:188</oboInOwl:hasDbXref>
