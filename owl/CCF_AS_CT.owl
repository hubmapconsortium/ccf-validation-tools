    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005899"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The oval-shaped tarsal bone found between the talus and the 3 cuneiform bones.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oval tarsal element that is located on the center of the mesopodium. It articulates with all other elements of the tarsus except tarsal 5.[AAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000008 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">connections vary depending on species. AAO: Oval tarsal element that is located on the center of the mesopodium. It articulates with all other elements of the tarsus except tarsal 5. In humans: there is a cuboid instead of distal tarsal 4 and 5 - may articulate laterally with the cuboid</obo:UBPROP_0000008>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">centrale</oboInOwl:hasBroadSynonym>
