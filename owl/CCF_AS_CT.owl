                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001182"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Ileocolic Artery is the lowest branch arising from the concavity of the superior mesenteric artery. It passes downward and to the right behind the peritoneum toward the right iliac fossa, where it divides into a superior and an inferior branch; the inferior anastomoses with the end of the superior mesenteric artery, the superior with the right colic artery. Supplies the cecum, ileum, and appendix. [WP,unvetted].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMAPA:37083</oboInOwl:hasDbXref>
