    <!-- http://purl.obolibrary.org/obo/CL_0020006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0020006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000617"/>
