        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">retinal neural layer</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">retinal neural layer</skos:prefLabel>
