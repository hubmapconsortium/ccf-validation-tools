    <!-- http://purl.obolibrary.org/obo/UBERON_0002414 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002414">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001130"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Large vertebra of the movable part of the vertebral column, characterized by the absence of the foramen transversarium within the transverse process, and by the absence of facets on the sides of the body.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000008 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Whereas all rats had six lumbar vertebrae, variable patterns in mice included mostly five vertebrae in DBA/2J, mostly six vertebrae in C57BL/6J, and a mix in B6129PF2/J</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CALOHA:TS-2364</oboInOwl:hasDbXref>
