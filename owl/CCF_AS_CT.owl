    <!-- http://purl.obolibrary.org/obo/UBERON_0002015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002015">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002113"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The tough fibrous layer surrounding the kidney which is covered in a thick layer of perirenal adipose tissue that functions to provide some protection from trauma and damage.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000009 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">provides some protection from trauma and damage.</obo:UBPROP_0000009>
        <obo:UBPROP_0000010 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The renal capsule relates to the other layers in the following order (moving from innermost to outermost): renal medulla renal cortex renal capsule perinephric fat (or &apos;perirenal fat&apos;) renal fascia paranephric fat (or &apos;pararenal fat&apos;) peritoneum (anteriorly), and transversalis fascia (posteriorly).[Wikipedia:Kidney_capsule]</obo:UBPROP_0000010>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMAPA:18679</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:66610</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MA:0000370</oboInOwl:hasDbXref>
