    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4042023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0011005"/>
        <rdfs:subClassOf>
            <owl:Restriction>
