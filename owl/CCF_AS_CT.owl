    <!-- http://purl.obolibrary.org/obo/UBERON_0011528 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011528">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000188"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The pubococcygeus muscle or PC muscle is a hammock-like muscle, found in both sexes, that stretches from the pubic bone to the coccyx (tail bone) forming the floor of the pelvic cavity and supporting the pelvic organs. It is part of the levator ani group of muscles.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:19090</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCTID:244958005</oboInOwl:hasDbXref>
