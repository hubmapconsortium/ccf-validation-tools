    <!-- http://purl.obolibrary.org/obo/CL_4030054 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4030054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_1001474"/>
