            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The posterior auricular vein begins upon the side of the head, in a plexus which communicates with the tributaries of the occipital vein and superficial temporal veins. It descends behind the auricula, and joins the posterior division of the posterior facial vein to form the external jugular. It receive the stylomastoid vein, and some tributaries from the cranial surface of the auricula.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000012 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">check placement of MA class</obo:UBPROP_0000012>
