    <!-- http://purl.obolibrary.org/obo/UBERON_0004612 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004612">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002413"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The third of the seven cervical vertebrae[ncit,modified].</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">under discussion: whether to generalize this beyond mammals, making it purely order-defined</obo:IAO_0000116>
        <obo:IAO_0000232 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">elements are to be defined spatially/topologically. all mammals have 7 cervical vertebrae</obo:IAO_0000232>
