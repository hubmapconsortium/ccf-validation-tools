        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://cellxgene.cziscience.com/cellguide/CL_1000768</rdfs:seeAlso>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Connecting Tubule Cell</skos:prefLabel>
