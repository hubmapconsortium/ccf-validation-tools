        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vastus intermedius</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vastus intermedius</skos:prefLabel>
    </owl:Class>
