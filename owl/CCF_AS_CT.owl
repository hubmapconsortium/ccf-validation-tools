        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010369"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget>
            <owl:Restriction>
