    <!-- http://purl.obolibrary.org/obo/UBERON_0001810 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001810">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anatomical junction where subdivisions of two or more neural trees interconnect with one another to form a network through which nerve fibers of the constituent nerve trees become regrouped; together with other nerve plexuses, nerves and ganglia, it constitutes the peripheral nervous system. Examples: cervical nerve plexus, brachial nerve plexus, sacral nerve plexus[FMA].</obo:IAO_0000115>
