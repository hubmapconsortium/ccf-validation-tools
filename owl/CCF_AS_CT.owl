    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000946"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An atrioventricular valve that is part of the outflow part of the right atrium.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The three-segmented valve of the heart that keeps blood in the right ventricle from flowing back into the right atrium. [TFD][VHOG]</obo:UBPROP_0000001>
