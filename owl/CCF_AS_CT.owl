    <!-- http://purl.obolibrary.org/obo/CL_0002080 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002080">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_1001433"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cubodial epithelial cell that is continuous with the lining of intercalated ducts that drain the acinus. This cell type secretes a high pH solution to aid in activation of zymogens, and can differentiate into endocrine and exocrine pancreatic cell types.</obo:IAO_0000115>
