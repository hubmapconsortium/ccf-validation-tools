    <!-- http://purl.obolibrary.org/obo/PCL_0015001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/PCL_0015001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_4023064"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001384"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000028 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inh L1 LAMP5 PVRL2 M1 (Human)</obo:IAO_0000028>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A GABAergic interneuron of the Homo sapiens primary motor cortex. These cells can be distinguished from other cells in the primary motor cortex by their selective expression of CBLN4 (Hsap), HS3ST5 (Hsap), RELN (Hsap), TRPC3 (Hsap). These cells also express LAMP5 (Hsap), PVRL2 (Hsap). The soma of these cells in located in: cortical layer I. The reference data for this cell type is CS201912131_1.</obo:IAO_0000115>
        <obo:PCL_0010058 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CBLN4 (Hsap)</obo:PCL_0010058>
        <obo:PCL_0010058 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HS3ST5 (Hsap)</obo:PCL_0010058>
        <obo:PCL_0010058 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RELN (Hsap)</obo:PCL_0010058>
        <obo:PCL_0010058 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRPC3 (Hsap)</obo:PCL_0010058>
