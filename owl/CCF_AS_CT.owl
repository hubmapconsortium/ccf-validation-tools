    <!-- http://purl.obolibrary.org/obo/UBERON_0001251 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001251">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The zone between the red and white pulp of the spleen containing numerous macrophages and lymphocytes, and a rich plexus of sinusoids supplied by white pulp arterioles carrying blood-borne antigens.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000012 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WP says - (Some sources consider it to be the part of red pulp which borders on the white pulp, while other sources consider it to be neither red pulp nor white pulp.) - we use the adjacency relation here so it overlaps neither. FMA considers this an anatomical line.</obo:UBPROP_0000012>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">marginal zone</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CALOHA:TS-2395</oboInOwl:hasDbXref>
