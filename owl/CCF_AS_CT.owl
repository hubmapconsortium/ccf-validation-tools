    <!-- http://purl.obolibrary.org/obo/UBERON_0009624 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0009624">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001780"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The lumbar nerves are the five spinal nerves emerging from the lumbar vertebrae. They are divided into posterior and anterior divisions.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:5861</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCIT:C33015</oboInOwl:hasDbXref>
