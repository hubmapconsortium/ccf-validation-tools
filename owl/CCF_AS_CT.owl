        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cerebellar cortex</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/a/a7/Cerebellum_NIH.png</foaf:depiction>
