        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">m. psoas major</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Psoas_major_muscle</oboInOwl:hasDbXref>
