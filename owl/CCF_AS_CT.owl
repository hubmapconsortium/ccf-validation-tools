        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The posterior digastric is a pharyngeal arch II muscle that participates in oral pharyngeal behavior, is innervated by the digastric branch of facial nerve and attaches to the posterior cranial base and the hyoid apparatus. It is found superficial to the mylohyoid muscle.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The posterior digastric is a pharyngeal arch II muscle that participates in oral pharyngeal behavior, is innervated by the digastric branchi of facial nerve and attaches to the posterior cranial base.[FEED]</obo:UBPROP_0000001>
        <obo:UBPROP_0000008 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in orangutans, this muscle attaches to the mandible rather than the hyoid</obo:UBPROP_0000008>
