        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The median nerve is the only nerve that passes through the carpal tunnel, where it may be compressed to cause carpal tunnel syndrome. [WP]</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
