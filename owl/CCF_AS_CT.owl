    <!-- http://purl.obolibrary.org/obo/CL_1000486 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_1000486">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000066"/>
