    <!-- http://purl.obolibrary.org/obo/UBERON_0002383 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002383">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001482"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The supraspinatus is a relatively small muscle of the upper limb that takes its name from its origin from the supraspinous fossa superior to the spine of the scapula. It is one of the four rotator cuff muscles and also abducts the arm at the shoulder. The spine of the scapula separates the supraspinatus muscle from the infraspinatus muscle, which originates below the spine. [WP,unvetted].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EHDAA2:0001967</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EHDAA:8319</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMAPA:18182</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:9629</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MA:0002389</oboInOwl:hasDbXref>
