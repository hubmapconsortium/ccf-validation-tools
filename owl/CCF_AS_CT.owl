        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Accessory pancreatic duct (Duct of Santorini)</skos:prefLabel>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Papilla of Santorini</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/1/15/Gray1100.png</foaf:depiction>
    </owl:Class>
