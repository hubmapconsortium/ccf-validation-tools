    <!-- http://purl.obolibrary.org/obo/UBERON_0001446 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001446">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The major postaxial endochondral bone in the posterior zeugopod[Phenoscape].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One of the two long bones of endochondral origin of the hind-epipodium; it is a rather more slender bone than the tibia but of about the same length.[AAO]</obo:UBPROP_0000001>
