    <!-- http://purl.obolibrary.org/obo/CL_0017004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0017004">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A supportive cell with a small, oval-shaped body and one to five telopodes. Telopodes are cytoplasmic protrusions from tens to hundreds of micrometers long and mostly below 0.2 microns of caliber.</obo:IAO_0000115>
