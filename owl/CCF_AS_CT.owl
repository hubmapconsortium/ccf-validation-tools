        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/cl.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">type I cell of carotid body</rdfs:label>
