    <!-- http://purl.obolibrary.org/obo/UBERON_0018679 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0018679">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003715"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thoracic splanchnic nerves are splanchnic nerves that arise from the sympathetic trunk in the thorax and travel inferiorly to provide sympathetic innervation to the abdomen. The nerves contain preganglionic sympathetic and general visceral afferent fibers.</obo:IAO_0000115>
