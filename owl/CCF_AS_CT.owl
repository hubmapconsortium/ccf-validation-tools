        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001678"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">os temporale</owl:annotatedTarget>
