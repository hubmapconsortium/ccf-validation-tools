    <!-- http://purl.obolibrary.org/obo/UBERON_0010369 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010369">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002048"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A unit of lung supplied by three to five terminal bronchioles and contained by fibrous septa.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a pyramidal mass of lung tissue with sides that are bounded by the incomplete interlobular connective tissue septa and with a base, which is 1-2 cm in diameter, which usually faces the pleural surface of the lung; lobules that occupy a more central position in the lung are not well defined and are considered to consist of three to five pulmonary acini with proximate terminal bronchioles.</obo:UBPROP_0000001>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6677-8489"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:7414</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lobulus pulmonis secondarius</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">respiratory lobule</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBERON:0010369</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">secondary pulmonary lobule</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">secondary pulmonary lobule</skos:prefLabel>
    </owl:Class>
