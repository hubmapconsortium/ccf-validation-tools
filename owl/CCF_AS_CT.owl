        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kidney distal convoluted tubule epithelial cell</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://cellxgene.cziscience.com/cellguide/CL_1000849</rdfs:seeAlso>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Distal Convoluted Tubule Cell</skos:prefLabel>
