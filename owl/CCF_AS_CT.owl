    <!-- http://purl.obolibrary.org/obo/UBERON_0001635 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001635">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000071"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002170"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001633"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The superior cerebellar artery (SCA) arises near the termination of the basilar artery. It passes lateralward, immediately below the oculomotor nerve, which separates it from the posterior cerebral artery, winds around the cerebral peduncle, close to the trochlear nerve, and, arriving at the upper surface of the cerebellum, divides into branches which ramify in the pia mater and anastomose with those of the inferior cerebellar arteries. Several branches are given to the pineal body, the anterior medullary velum, and the tela chorioidea of the third ventricle. [WP,unvetted].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EHDAA2:0000681</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMAPA:19309</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:50573</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MA:0001934</oboInOwl:hasDbXref>
