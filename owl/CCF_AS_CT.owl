    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002707">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The corticospinal fibers that arise from the pyramidal cells within the cerebral cortex layer V of the precentral motor area, the premotor area and the postcentral gyrus, then descend into and through the medulla to form the lateral corticospinal tract and the anterior corticospinal tract.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasAlternativeId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBERON:0004095</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pyramidal tract</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BAMS:P</oboInOwl:hasDbXref>
