    <!-- http://purl.obolibrary.org/obo/UBERON_0002127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0019263"/>
