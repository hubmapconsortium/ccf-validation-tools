    <!-- http://purl.obolibrary.org/obo/CL_0002068 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002068">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specialized cardiac myocyte that is subendocardially interspersed with the regular cardiac muscle cell. They are uninucleate cylindrical cells, associated end-to-end in long rows, continue from the node to the atrioventricular bundle; relatively short compared to ordinary myocytes but are nearly twice their diameter.</obo:IAO_0000115>
