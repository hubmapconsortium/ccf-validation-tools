    <!-- http://purl.obolibrary.org/obo/UBERON_0001306 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001306">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cluster of cells that project into the cavity of the mature ovarian follicle. It is released with the embedded oocyte during ovulation. In order for fertilization to occur this layer must be penetrated by the spermatocyte. [WP,modified].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMAPA:35267</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:18659</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MA:0002414</oboInOwl:hasDbXref>
