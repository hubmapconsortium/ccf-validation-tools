    <!-- http://purl.obolibrary.org/obo/UBERON_0008889 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0008889">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004537"/>
