        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wide vessels in the spleen that drain into trabecular veins[WP].</obo:IAO_0000115>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10088"/>
