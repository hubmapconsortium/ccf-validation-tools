            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002170"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001586"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The lingual veins begin on the dorsum, sides, and under surface of the tongue, and, passing backward along the course of the lingual artery, end in the internal jugular vein. The vena comitans of the hypoglossal nerve (ranine vein), a branch of considerable size, begins below the tip of the tongue, and may join the lingual; generally, however, it passes backward on the Hyoglossus, and joins the common facial.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vein which collects blood from the tongue and drains into the external jugular vein.[AAO]</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAO:0010514</oboInOwl:hasDbXref>
