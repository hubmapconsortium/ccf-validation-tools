        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">external intercostal muscle</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">external intercostal muscle</skos:prefLabel>
