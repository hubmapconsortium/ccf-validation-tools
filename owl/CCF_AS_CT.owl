        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Adductor hallucis (Adductor obliquus hallucis) arises by two headsboblique and transverse and is responsible for adducting the big toe. It is innervated by the lateral plantar nerve. It evolved from the contrahens I muscle as Man&apos;s ancestors&apos; thumbs and big toes became opposable.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:37454</oboInOwl:hasDbXref>
