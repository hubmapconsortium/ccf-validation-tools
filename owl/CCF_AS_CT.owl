        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Vertebral_vein</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vena vertebralis</oboInOwl:hasRelatedSynonym>
