    <!-- http://purl.obolibrary.org/obo/UBERON_0001572 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001572">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001575"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A muscle that attaches to the hyopid bone and to the tongue and is innervated by cranial nerve XII.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Makes up part of the tongue in frogs and salamanders.[AAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The hyoglossus is a muscle that attaches to the hyoid and tongue and is innervated by Cranial Nerve XII.[FEED]</obo:UBPROP_0000001>
        <obo:UBPROP_0000002 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relationship loss: subclass hyobranchial muscles (AAO:0000224)[AAO]</obo:UBPROP_0000002>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAO:0010663</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMAPA:18277</oboInOwl:hasDbXref>
