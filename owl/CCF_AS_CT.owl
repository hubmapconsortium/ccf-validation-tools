    <!-- http://purl.obolibrary.org/obo/UBERON_0005382 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005382">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002435"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dorsal components of the striatum comprising the caudate nucleus and the putamen, in species that have distinct nuclei; the caudoputamen in species which don&apos;t.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">According to BrainInfo it is a part of the basal ganglia comprising the globus pallidus and striatum</obo:UBPROP_0000001>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">According to the 1917 version of Gray&apos;s Anatomy, it is the combination of the lentiform nucleus (putamen and the globus pallidus) and the caudate nucleus</obo:UBPROP_0000001>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">It may also refer to both the basal ganglia and the internal capsule collectively.</obo:UBPROP_0000001>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">It may also refer to the putamen and caudate collectively.</obo:UBPROP_0000001>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The term dorsal striatum refers to a composite structure of the endbrain that is defined in the striatopallidal system by connectivity and neurochemical staining. It includes most of the striatum ( Heimer-1995 ). The boundary between this structure and the ventral striatum is indistinct in sections stained for Nissl substance.</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BAMS:Dorsal_striatum</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BAMS:STRd</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BAMS:StrD</oboInOwl:hasDbXref>
