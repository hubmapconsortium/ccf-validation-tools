        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The posterior cerebral artery (PCA) is one of a pair of blood vessels that supplies oxygenated blood to the posterior aspect of the brain in human anatomy]. It arises near the intersection of the posterior communicating artery and the basilar artery and connects with the ipsilateral middle cerebral artery (MCA) and internal carotid artery via the posterior communicating artery (PCommA). [WP,unvetted].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EHDAA2:0000659</oboInOwl:hasDbXref>
