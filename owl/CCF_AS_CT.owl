        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">main ciliary ganglion</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">main ciliary ganglion</skos:prefLabel>
