    <!-- http://purl.obolibrary.org/obo/UBERON_0018651 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0018651">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A triangular hole in the base of the skull located at the base of the medial pterygoid plate.</obo:IAO_0000115>
        <obo:UBPROP_0000013 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">For comparative reasons this term can only be used for the opening between the Os temporale, Os basisphenoidale, and Os occipitale (formerly the Foramen lacerum orale of the pig and horse). That which was formerly called Foramen lacerum aborale is the Foramen jugulare [NOMINA ANATOMICA VETERINARIA (2005)]</obo:UBPROP_0000013>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:54809</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCTID:369444009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Foramen_lacerum</oboInOwl:hasDbXref>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBERON:0018651</oboInOwl:id>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foramen lacerum</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foramen lacerum of sphenoid bone</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0018651"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A triangular hole in the base of the skull located at the base of the medial pterygoid plate.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Foramen_lacerum</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0018653 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0018653">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The anterior ethmoidal foramen, situated about the middle of the lateral margin of the olfactory groove, transmits the anterior ethmoidal vessels and the anterior ethmoidal nerve; the nerve runs in a groove along the lateral edge of the cribriform plate to the slit-like opening above mentioned.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:53135</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Anterior_ethmoidal_foramen</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">foramina ethmoidalia anterius</oboInOwl:hasExactSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBERON:0018653</oboInOwl:id>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anterior ethmoidal foramen</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anterior ethmoidal foramen of ethmoid bone</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
