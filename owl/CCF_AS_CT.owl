        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An endothelial cell that is part of the peritubular capillary of the kidney. This cell is highly fenestrated and plays a vital role in the kidney&apos;s filtration process, enabling the exchange of materials between the blood and the renal tubules.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
