    <!-- http://purl.obolibrary.org/obo/UBERON_0008572 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0008572">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001568"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The posterior cricoarytenoid muscles are extremely small, paired muscles that extend from the posterior cricoid cartilage to the arytenoid cartilages in the larynx. By rotating the arytenoid cartilages laterally, these muscles abduct the vocal cords and thereby open the rima glottidis. Their action opposes the lateral cricoarytenoid muscles. The posterior cricoarytenoid muscles receive innervation from the recurrent laryngeal branch of the vagus nerve (CN X). Paralysis of the posterior cricoarytenoid muscles may lead to asphyxiation as they are the only laryngeal muscles to open the true vocal folds, allowing inspiration and expiration.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:46576</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCTID:244812005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Posterior_cricoarytenoid_muscle</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">posterior cricoarytenoid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">posterior cricoarytenoid muscle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">posterior cricoarytenoideus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cricoarytaenoideus posterior</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cricoarytænoideus posterior</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">musculus cricoarytenoideus posterior</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBERON:0008572</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">posterior crico-arytenoid</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">posterior cricoarytenoid muscle</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/9/9d/Musculuscricoarytenoideusposterior.png</foaf:depiction>
    </owl:Class>
