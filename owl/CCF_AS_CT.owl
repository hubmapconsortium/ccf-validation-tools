            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Each (left and right) superior suprarenal artery is a branch of the inferior phrenic artery on that side of the body. The left and right phrenic arteries supply the diaphragm, and come off the aorta. [WP,unvetted].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
