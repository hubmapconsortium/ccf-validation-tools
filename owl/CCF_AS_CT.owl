            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The transversospinal muscles are a group of muscles of the human back. Their combined action is rotation and extension of the vertebral column. They include: semispinalis, spanning 4-6 vertebral segments semispinalis dorsi semispinalis cervicis semispinalis capitis multifidus, spanning 2-4 vertebral segments rotatores, spanning 1-2 vertebral segments rotatores cervicis rotatores thoracis rotatores lumborum.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EHDAA2:0002075</oboInOwl:hasDbXref>
