    <!-- http://purl.obolibrary.org/obo/UBERON_0010379 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010379">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002170"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001601"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The superior tarsal muscle is a smooth muscle adjoining the levator palpebrae superioris muscle that helps to raise the upper eyelid.</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">declaring this to be both smooth muscle and part of the LPS leads to a disjointness violation (smooth muscle and striated muscle)</obo:IAO_0000116>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:49058</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCTID:244775007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Superior_tarsal_muscle</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mueller&apos;s muscle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Muller&apos;s muscle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Müller&apos;s muscle</oboInOwl:hasRelatedSynonym>
