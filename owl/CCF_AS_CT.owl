            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A bilaterally paired branched artery that originates from the aortic arches and divides into and includes as parts the internal and external carotid arteries[cjm].</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">we follow the FMA and treat the artery as a tree-structure - here we include the internal and external as parts. For the part that excludes the branches, see &apos;trunk of common carotid artery&apos;</obo:IAO_0000116>
        <obo:IAO_0000232 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This class represents the adult and developing structures&apos;</obo:IAO_0000232>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000011 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in birds and reptiles, develops from arch III and parts of ventral and dorsal aortae</obo:UBPROP_0000011>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">carotid artery</oboInOwl:hasBroadSynonym>
