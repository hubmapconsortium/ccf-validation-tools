    <!-- http://purl.obolibrary.org/obo/UBERON_0006958 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006958">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003498"/>
