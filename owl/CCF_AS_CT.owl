    <!-- http://purl.obolibrary.org/obo/CL_0000784 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000784">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
