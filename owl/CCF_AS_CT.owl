            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A turbinal located on the maxilla bone.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000008 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In many carnivores and ungulates, the maxilloturbinal is the most complex element immediately posterior to the vestibule[PMID:25312359]</obo:UBPROP_0000008>
        <obo:UBPROP_0000009 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">While the maxilloturbinates of mammals are located in the path of airflow to collect moisture, sensory turbinates in both mammals and reptiles are positioned farther back and above the nasal passage, away from the flow of air</obo:UBPROP_0000009>
        <obo:UBPROP_0000012 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in FMA this is not classified with the other turbinates. In Uberon we subdivide the turbinates into the ethmoturbinates and the inferior turbinate. EDITOR NOTE: TODO check ethmoidal process of inferior nasal concha</obo:UBPROP_0000012>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:54736</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCIT:C32794</oboInOwl:hasDbXref>
