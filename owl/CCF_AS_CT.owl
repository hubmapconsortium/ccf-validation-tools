    <!-- http://purl.obolibrary.org/obo/UBERON_0010396 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010396">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001473"/>
