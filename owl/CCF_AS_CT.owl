        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A muscle organ that attaches the tongue to some other structure.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Muscles_of_tongue</oboInOwl:hasDbXref>
