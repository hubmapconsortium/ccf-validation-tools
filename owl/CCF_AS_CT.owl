        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Some literature reports don&apos;t consider the external anal sphincter to be a true sphincter muscle.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
