        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">in ABA, this is part of the brain stem</owl:annotatedTarget>
        <oboInOwl:external_ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ABA</oboInOwl:external_ontology>
