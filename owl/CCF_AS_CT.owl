        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000011"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Upon reaching its final destination, the ventral pancreatic bud fuses with the much larger dorsal pancreatic bud. At this point of fusion, the main ducts of the ventral and dorsal pancreatic buds fuse, forming the duct of Wirsung, the main pancreatic duct.</owl:annotatedTarget>
        <oboInOwl:source rdf:datatype="http://www.w3.org/2001/XMLSchema#string">WP</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
