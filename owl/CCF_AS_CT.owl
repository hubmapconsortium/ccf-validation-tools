    <!-- http://purl.obolibrary.org/obo/UBERON_0009625 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0009625">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001780"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The five sacral nerves emerge from the sacrum. Although the vertebral components of the sacrum are fused into a single bone, the sacral vertebrae are still used to number the sacral nerves. Posteriorly, they emerge from the posterior sacral foramina, and form the posterior branches of sacral nerves. Anteriorly, they emerge from the anterior sacral foramina, and contribute to the sacral plexus (S1-S4) and coccygeal plexus.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
