        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nervus visceralis</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:5866</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
