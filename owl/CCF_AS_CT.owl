        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tracheal muscle</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:7466</oboInOwl:hasDbXref>
    </owl:Axiom>
