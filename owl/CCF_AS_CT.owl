        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The thyrohyoid muscle is a small, quadrilateral muscle appearing like an upward continuation of the Sternothyreoideus. It belongs to the infrahyoid muscles group. It arises from the oblique line on the lamina of the thyroid cartilage, and is inserted into the lower border of the greater cornu of the hyoid bone. [WP,unvetted].</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Thyrohyoid_muscle</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001110"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The thyrohyoid is a somitic muscle that participates in oral/pharyngeal behaviors and is innervated by C1 and Cranial Nerve XII ; it attaches to the thyroid cartilage and the hyoid apparatus.[FEED]</owl:annotatedTarget>
        <oboInOwl:date_retrieved rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-02</oboInOwl:date_retrieved>
        <oboInOwl:ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FEED</oboInOwl:ontology>
        <oboInOwl:url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.feedexp.org</oboInOwl:url>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001110"/>
