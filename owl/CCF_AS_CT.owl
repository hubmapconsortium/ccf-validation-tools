    <!-- http://purl.obolibrary.org/obo/UBERON_0002381 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002381">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001495"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The pectoralis major is a thick, fan-shaped muscle, situated at the upper front of the chest wall. It makes up the bulk of the chest muscles in the male and lies under the breast in the female. Underneath the pectoralis major is the pectoralis minor, a thin, triangular muscle. [WP,unvetted].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EHDAA2:0001424</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EHDAA:8311</oboInOwl:hasDbXref>
