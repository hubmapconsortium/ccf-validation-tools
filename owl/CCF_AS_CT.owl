        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The lens is avascular and nourished by diffusion from the aqueous and vitreous humors.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lens of camera-type eye</rdfs:label>
