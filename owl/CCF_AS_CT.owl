        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The deepest layer of the epidermis, which is composed of dividing stem cells and anchoring cells.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000009 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">replaces damaged cells on outside of body</obo:UBPROP_0000009>
        <obo:UBPROP_0000010 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">consisting of non-keratinized, viable cells, in contrast to the outer (upper) layer of epidermis made up of keratinized, anucleated, non-viable cells</obo:UBPROP_0000010>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Malpighian layer</oboInOwl:hasBroadSynonym>
