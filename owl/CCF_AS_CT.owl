    <!-- http://purl.obolibrary.org/obo/UBERON_0001128 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001128">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000188"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A paired muscle in the superficial layers of the anterior portion of the neck. It acts to flex and rotate the head. It also acts as an accessory muscle of inspiration, along with the scalene muscles of the neck. [WP,unvetted].</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TODO: sternocleidomastoid = sternomastoid + Cleidomastoideus. Origin: from manubrium sterni (sterno) and clavicle (cleido) and it&apos;s insertion at the mastoid process of the temporal bone.</obo:IAO_0000116>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000003 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The sternomastoid and the three parts of the trapezius are branchiomeric muscles that have secondarily acquired an attachment to the pectoral girdle. They evolved from the fish cucullaris.[well established][VHOG]</obo:UBPROP_0000003>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCM</oboInOwl:hasBroadSynonym>
