    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000402">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">OBSOLETE. An interneuron that has its cell body in a central nervous system.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/obophenotype/cell-ontology/issues/2869"/>
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/CL_0000099"/>
