        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">immature intermediate villus</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:21452443</oboInOwl:hasDbXref>
