    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003648">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005897"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A metacarpal bone that distally_connected_to a proximal phalanx of manual digit 4.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The fourth metacarpal bone (metacarpal bone of the ring finger) is shorter and smaller than the third. The base is small and quadrilateral; its superior surface presents two facets, a large one medially for articulation with the hamate, and a small one laterally for the capitate. On the radial side are two oval facets, for articulation with the third metacarpal; and on the ulnar side a single concave facet, for the fifth metacarpal[Wikipedia:Fourth_metacarpal_bone].</obo:UBPROP_0000001>
        <obo:UBPROP_0000104 rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</obo:UBPROP_0000104>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAO:0010615</oboInOwl:hasDbXref>
