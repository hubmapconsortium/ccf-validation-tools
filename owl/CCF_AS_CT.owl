    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000569">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The ileocecal valve is a sphincter muscle situated at the junction of the small intestine (ileum) and the large intestine. Its critical function is to limit the reflux of colonic contents into the ileum.</obo:IAO_0000115>
