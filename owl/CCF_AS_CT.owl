        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">exocrine glandular system</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EHDAA2:0002225</oboInOwl:hasDbXref>
