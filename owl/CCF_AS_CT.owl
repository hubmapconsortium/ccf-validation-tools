        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The transverse or costal processes of a vertebra, two in number, project one at either side from the point where the lamina joins the pedicle, between the superior and inferior articular processes. They serve for the attachment of muscles and ligaments. [WP,unvetted].</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Transverse_process</oboInOwl:hasDbXref>
    </owl:Axiom>
