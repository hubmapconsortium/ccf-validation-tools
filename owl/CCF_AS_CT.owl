            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A region of the lens consisting of packed elongated enucleate cells packed with crystallin.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fibres resembling a ribbon and arranged in very thin plates in the lens. [Dorian_AF, Elsevier&apos;s_encyclopaedic_dictionary_of_medicine, Part_B:_Anatomy_(1988)_Amsterdam_etc.:_Elsevier][VHOG]</obo:UBPROP_0000001>
        <obo:UBPROP_0000003 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">(...) the line, or Y, or star sutures common to mammalian lenses, including those of primates. In the case of line or Y sutures, the overlapping of lens fibers in each successive shell is coincident and results in the formation of four or six three-dimensional suture planes that extend from the lens nucleus to the periphery.[well established][VHOG]</obo:UBPROP_0000003>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BTO:0000724</oboInOwl:hasDbXref>
