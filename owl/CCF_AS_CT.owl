        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non-encoded relationships from VSAO - capable_of_producing VSAO:0000020</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/cl.owl"/>
