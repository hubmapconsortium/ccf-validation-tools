        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002872"/>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002877"/>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000003 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The inferior olive appears to be present in all vertebrate classes and is particularly well developed in species with a well-developed cerebellum.[well established][VHOG]</obo:UBPROP_0000003>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BAMS:IO</oboInOwl:hasDbXref>
