        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Coracobrachialis is the smallest of the three muscles that attach to the coracoid process of the scapula. (The other two muscles are pectoralis minor and biceps brachii. ) It is situated at the upper and medial part of the arm. It is perforated by and innervated by the musculocutaneous nerve. [WP,unvetted].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMAPA:36182</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:37664</oboInOwl:hasDbXref>
