        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The iliocostalis dorsi (musculus accessorius; iliocostalis thoracis) arises by flattened tendons from the upper borders of the angles of the lower six ribs medial to the tendons of insertion of the iliocostalis lumborum; these become muscular, and are inserted into the upper borders of the angles of the upper six ribs and into the back of the transverse process of the seventh cervical vertebra.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMAPA:37604</oboInOwl:hasDbXref>
