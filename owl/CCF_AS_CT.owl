    <!-- http://purl.obolibrary.org/obo/UBERON_0008571 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0008571">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000383"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A muscle in the region above the hyoid bone in the neck. The suprahyoid muscles include digastric, stylohyoid, geniohyoid, and mylohyoid.</obo:IAO_0000115>
