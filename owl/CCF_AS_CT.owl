        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">thoracic vertebra</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/d/d2/Gray90.png</foaf:depiction>
