        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cardiac atrium that is in the left side of the heart. It receives oxygenated blood from the pulmonary veins, In mammals this is pumped into the left ventricle, via the Mitral valve.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Left_atrium</oboInOwl:hasDbXref>
