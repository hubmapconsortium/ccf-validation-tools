        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SRGN (Hsap), HIF1A-AS3 (Hsap) expressing microglial cell of brain (Homo sapiens)</oboInOwl:hasExactSynonym>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/pcl.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mgl_4 microglial cell (Hsap)</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mgl_4</skos:prefLabel>
    </owl:Class>
