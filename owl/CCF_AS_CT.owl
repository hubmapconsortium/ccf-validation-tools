            </owl:Restriction>
        </owl:annotatedTarget>
        <class_helper:IN_OBO rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True</class_helper:IN_OBO>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-04-22T08:35:27.517499</dc:date>
