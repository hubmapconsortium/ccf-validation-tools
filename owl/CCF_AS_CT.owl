        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interstitial cells of Cajal</skos:prefLabel>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interstitial cell of Cajal</skos:prefLabel>
