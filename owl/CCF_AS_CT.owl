            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thickening of the proximal end of the hair follicle. Contains rapidly proliferating, rather undifferentiated matrix cells (transient amplifying cells), melanocytes and outer root sheath cells.</obo:IAO_0000115>
