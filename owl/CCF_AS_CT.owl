        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The internal pudendal artery is an artery that branches off the internal iliac artery, providing blood to the external genitalia. The internal pudendal artery is the terminal branch of the anterior trunk of the internal iliac artery. It is smaller in the female than in the male.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Internal_pudendal_artery</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
