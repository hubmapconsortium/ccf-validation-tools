    <!-- http://purl.obolibrary.org/obo/UBERON_0001516 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001516">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002170"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002345"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Abdominal part of aorta: the distal part of the descending aorta, which is the continuation of the thoracic part and gives rise to the inferior phrenic, lumbar, median sacral, superior and inferior mesenteric, middle suprarenal, renal, and testicular or ovarian arteries, and celiac trunk[BTO]. The abdominal aorta is the largest artery in the abdominal cavity. As part of the aorta, it is a direct continuation of descending aorta(of the thorax). [WP,unvetted].</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Many of the branches of the abdominal aorta in mammals may be branches of the dorsal aorta in other vertebrates</obo:IAO_0000116>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BTO:0002976</oboInOwl:hasDbXref>
