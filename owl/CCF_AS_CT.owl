                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001589"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A vein that drains into the internal thoracic vein, anastomosing with the inferior epigastric vein at the level of the umbilicus and drains the anterior part of the abdominal wall and some of the diaphragm. Along its course, it is accompanied by a similarly named artery, the superior epigastric artery.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMAPA:18761</oboInOwl:hasDbXref>
