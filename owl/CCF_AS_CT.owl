        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hepatic flexure</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:14550</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
