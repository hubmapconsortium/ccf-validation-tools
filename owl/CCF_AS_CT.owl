    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0019258"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Regional part of medullary white matter (according to Neuronames) primarily found at the level of the open medulla, consisting of a large bundle of fibers projecting to and projecting from the cerebellum. The icp is continuous with the dorsal spinocerebellar tract and also contains a large number of fibers originating in the inferior olivary complex (MM).</obo:IAO_0000115>
