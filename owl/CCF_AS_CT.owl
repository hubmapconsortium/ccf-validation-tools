    <!-- http://purl.obolibrary.org/obo/UBERON_0036174 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0036174">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000188"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The flexor digiti minimi brevis is a muscle in the hand that flexes the little finger. It lies in the same plane as the abductor digiti minimi, on its radial side.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:37383</oboInOwl:hasDbXref>
