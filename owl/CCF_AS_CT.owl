    <!-- http://purl.obolibrary.org/obo/UBERON_0006634 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006634">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000071"/>
            </owl:Restriction>
