    <!-- http://purl.obolibrary.org/obo/UBERON_0000950 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000950">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000188"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The most superficial muscle on the medial side of the thigh. It is thin and flattened, broad above, narrow and tapering below. It arises by a thin aponeurosis from the anterior margins of the lower half of the symphysis pubis and the upper half of the pubic arch.</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AAO has minor and major gracilis, which merge together, attaching the pelvic rim to the tibiofibula - this could be grouped with the mammalian gracilis at some level; note the current insertion site is &apos;tibia&apos; which would be modified for amphibian tibiafibula</obo:IAO_0000116>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000008 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A&amp;P heads in rat, single head in humans[DOI:10.1002/ar.22919]</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BTO:0000536</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMAPA:36231</oboInOwl:hasDbXref>
