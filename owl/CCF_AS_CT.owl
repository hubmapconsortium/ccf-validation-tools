    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CL_0000837 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000837">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A hematopoietic multipotent progenitor cell is multipotent, but not capable of long-term self-renewal. These cells are characterized as lacking lineage cell surface markers and being CD34-positive in both mice and humans.</obo:IAO_0000115>
