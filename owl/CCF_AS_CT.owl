    <!-- http://purl.obolibrary.org/obo/UBERON_8410036 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_8410036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_8410041"/>
