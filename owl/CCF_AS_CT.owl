        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amygdalohippocampal area</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amygdalohippocampal area</skos:prefLabel>
    </owl:Class>
