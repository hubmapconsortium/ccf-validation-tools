    <!-- http://purl.obolibrary.org/obo/CL_0002228 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0011004"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An elongating cell that rapidly obliterates the lumen of the lens vesicle. Subsequently, differentiation of this cell type at the lens equator leads to the formation of secondary fiber cells that come to overlie the primary fibers.</obo:IAO_0000115>
