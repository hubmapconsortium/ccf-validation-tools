        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The hemiazygos vein (vena azygos minor inferior) is a vein running superiorly in the lower thoracic region, just to the left side of the vertebral column.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000008 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The major anatomic variation between the pig and other mammalian species is the presence of the large left azygos vein, which enters the coronary sinus (Fig. 1). In other mammals, hemiazygos vein enters the pre- cava.</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EHDAA2:0004534</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">EMAPA:18251</oboInOwl:hasDbXref>
