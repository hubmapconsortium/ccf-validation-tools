        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tensor tympani</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tensor tympani muscle</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/8/82/Gray912.png</foaf:depiction>
