    <!-- http://purl.obolibrary.org/obo/UBERON_0001065 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001065">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001831"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The main excretory tubular canal that connects the parotid gland and the buccal mucosa and secretes a serous saliva into the vestibule of the oral cavity; it arises from the anterior surface of the gland, traversing the masseter muscle; the duct then pierces the buccinator muscle, moving medially, and opens out into the oral cavity near the second upper molar; saliva produced by acinar secretory cells in the glandular body flows sequentially through the intercalated ducts, striated ducts, and excretory ducts.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">duct of parotid</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">duct of parotid gland</oboInOwl:hasBroadSynonym>
