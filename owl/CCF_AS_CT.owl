                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001778"/>
            </owl:Restriction>
        </owl:annotatedTarget>
        <class_helper:IN_OBO rdf:datatype="http://www.w3.org/2001/XMLSchema#string">True</class_helper:IN_OBO>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-04-22T08:29:00.289367</dc:date>
