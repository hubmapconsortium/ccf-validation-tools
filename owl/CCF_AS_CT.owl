    <!-- http://purl.obolibrary.org/obo/UBERON_0001183 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001183">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001516"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000071"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mesenteric artery that supplies the large intestine from the left colic (or splenic) flexure to the upper part of the rectum, which includes the descending colon, the sigmoid colon, and part of the rectum. Proximally, its territory of distribution overlaps (forms a watershed) with the middle colic artery, and therefore the superior mesenteric artery. The SMA and IMA anastomose via the marginal artery (artery of Drummond). The territory of distribution of the IMA is more or less equivalent to the embryonic hindgut. [WP,unvetted].</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IMA</oboInOwl:hasBroadSynonym>
