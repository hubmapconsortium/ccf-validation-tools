        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:3259815</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010369"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a pyramidal mass of lung tissue with sides that are bounded by the incomplete interlobular connective tissue septa and with a base, which is 1-2 cm in diameter, which usually faces the pleural surface of the lung; lobules that occupy a more central position in the lung are not well defined and are considered to consist of three to five pulmonary acini with proximate terminal bronchioles.</owl:annotatedTarget>
