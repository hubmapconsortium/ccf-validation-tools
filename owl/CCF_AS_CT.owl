    <!-- http://purl.obolibrary.org/obo/UBERON_0013688 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0013688">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010754"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A germinal center that is part of a tonsil.</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">consider adding related terms, e.g. secondary lymphoid tissue of tonsil</obo:IAO_0000116>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The germinal center or reaction center is the activated center of a lymphoid follicle in secondary lymphoid tissue where B-lymphocytes are stimulated by antigens and helper T cells (T-lymphocytes, helper-inducer) are stimulated to generate memory cells. Here, the germinal center of a tonsil[TS-1288].</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CALOHA:TS-1288</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tonsil reaction center</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBERON:0013688</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tonsil germinal center</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tonsil germinal center</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013688"/>
