    <!-- http://purl.obolibrary.org/obo/UBERON_0009042 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0009042">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004537"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000071"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The prostatic veins form a well-marked prostatic plexus which lies partly in the fascial sheath of the prostate and partly between the sheath and the prostatic capsule. It communicates with the pudendal and vesical plexuses.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:29711</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCTID:303052003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Prostatic_venous_plexus</oboInOwl:hasDbXref>
