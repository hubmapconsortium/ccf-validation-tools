    <!-- http://purl.obolibrary.org/obo/UBERON_0000990 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000990">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000467"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anatomical system that has as its parts the organs concerned with reproduction.</obo:IAO_0000115>
        <obo:IAO_0000116 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">consider splitting genitalia from reproductive system</obo:IAO_0000116>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anatomical system which consists of organs and tissues associated with sexual reproduction of the organism.[AAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000003 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arguably, one of the most important aspects of urbilaterian organogenesis would have been gonadogenesis, since Urbilateria must have successfully generated gametes and developed a strategy for extrusion and fertilization, in order to be the ancestor of all living Bilateria.[well established][VHOG]</obo:UBPROP_0000003>
        <obo:UBPROP_0000202 rdf:resource="http://purl.obolibrary.org/obo/FMA_75572"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2022-06-10T18:22:34+00:00</terms:date>
