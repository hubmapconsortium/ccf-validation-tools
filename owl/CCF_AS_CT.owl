    <!-- http://purl.obolibrary.org/obo/CL_4033050 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4033050">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neuron that releases catecholamine as a neurotransmitter.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6677-8489"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-05-18T12:07:45+00:00</terms:date>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Frequently used when describing the developing nervous system in zebrafish. A catecholaminergic neuron expresses tyrosine hydroxylase (TH), tyrosine hydroxylase 2 (TH2), aromatic amino acid decarboxylase (AADC), dopamine b-hydroxylase (DBH), and phenylethanolamine-N-methyl transferase (PEMT), which are enzymes necessary for catecholamine synthesis.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/cl.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">catecholaminergic neuron</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Catecholaminergic Neuron</skos:prefLabel>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">catecholaminergic neuron</skos:prefLabel>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4033050"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neuron that releases catecholamine as a neurotransmitter.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ISBN:0521442516</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:12094209</oboInOwl:hasDbXref>
