        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-04-22T08:58:37.768512</dc:date>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011192"/>
