        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">musculus flexor digiti minimi brevis (manus)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">flexor brevis minimi digiti muscle (hand)</oboInOwl:hasRelatedSynonym>
