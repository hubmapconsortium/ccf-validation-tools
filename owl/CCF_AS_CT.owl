        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">posterior deep lingual gland</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMCID:PMC2667924</oboInOwl:hasDbXref>
    </owl:Axiom>
