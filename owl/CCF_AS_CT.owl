    <!-- http://purl.obolibrary.org/obo/UBERON_0010937 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010937">
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The salpingopharyngeus muscle arises from the inferior part of the cartilage of the pharyngotympanic tube (Eustachian tube) in the nasal cavity; it passes downward and blends with the posterior fasciculus of the palatopharyngeus muscle. The salpingopharyngeus is known to raise the pharynx and larynx during deglutition (swallowing) and laterally draws the pharyngeal walls up. In addition, it opens the pharyngeal orifice of the pharyngotympanic tube during swallowing. This allows for the equalization of pressure between the auditory canal and the pharynx. The salpingopharyngeus is innervated by the vagus nerve (CN X) via the pharyngeal plexus.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Salpingopharyngeus is a muscle that attaches to pharyngotympanic tube and the pharynx and is innervated by pharyngeal plexus of CN X and participates in oral/pharyngeal behaviors.[FEED]</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:46665</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">NCIT:C33510</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SCTID:244807009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C1521985</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Salpingopharyngeus_muscle</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">salpingopharyngeus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">musculus salpingopharyngeus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UBERON:0010937</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">salpingopharyngeus muscle</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">salpingopharyngeus muscle</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/e/e3/Salpingopharyngeus.png</foaf:depiction>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010937"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The salpingopharyngeus muscle arises from the inferior part of the cartilage of the pharyngotympanic tube (Eustachian tube) in the nasal cavity; it passes downward and blends with the posterior fasciculus of the palatopharyngeus muscle. The salpingopharyngeus is known to raise the pharynx and larynx during deglutition (swallowing) and laterally draws the pharyngeal walls up. In addition, it opens the pharyngeal orifice of the pharyngotympanic tube during swallowing. This allows for the equalization of pressure between the auditory canal and the pharynx. The salpingopharyngeus is innervated by the vagus nerve (CN X) via the pharyngeal plexus.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Salpingopharyngeus_muscle</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010937"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Salpingopharyngeus is a muscle that attaches to pharyngotympanic tube and the pharynx and is innervated by pharyngeal plexus of CN X and participates in oral/pharyngeal behaviors.[FEED]</owl:annotatedTarget>
        <oboInOwl:date_retrieved rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2012-07-02</oboInOwl:date_retrieved>
        <oboInOwl:ontology rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FEED</oboInOwl:ontology>
        <oboInOwl:url rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://www.feedexp.org</oboInOwl:url>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010937"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
