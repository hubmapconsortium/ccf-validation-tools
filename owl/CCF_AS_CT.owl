        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">capitulum of humerus</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">capitulum of humerus</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/b/b9/Capitulumhumeri.PNG</foaf:depiction>
