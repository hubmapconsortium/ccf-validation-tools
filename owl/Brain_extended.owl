    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002477"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002171"/>
        <owl:annotatedTarget rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002476"/>
