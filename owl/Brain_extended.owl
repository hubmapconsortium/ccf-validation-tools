    <!-- http://purl.obolibrary.org/obo/CL_4042025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4042025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_2000097"/>
