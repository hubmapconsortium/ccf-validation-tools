        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">optic radiation</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">optic radiation</skos:prefLabel>
