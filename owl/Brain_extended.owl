        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#BDS_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The marker set RXRG, THSD7B can identify the Human cell type sncg GABAergic cortical interneuron in the neocortex with a confidence of 0.628943702 (NS-Forest FBeta value).</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The marker set RXRG, THSD7B can identify the Human cell type sncg GABAergic interneuron in the neocortex with a confidence of 0.628943702 (NS-Forest FBeta value).</rdfs:comment>
