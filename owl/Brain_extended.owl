        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Some sources treat the subthalamus as distinct from the thalamus, separated by the zona limitans intrathalamica. In MA, the ventral thalamus is part of the thalamus. Butler Hodos who identify a dorsal to ventral sequence consisting of epithalamus, dorsal thalamus, ventral thalamus and hypothalamus. We solve this by considering dorsal and ventral thalamus distinct, and the label thalamus as being ambiguous w.r.t thalamus proper (dorsal thalamus) or wider thalamus (dorsal plus ventral)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ventral thalamus</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ventral thalamus</skos:prefLabel>
    </owl:Class>
