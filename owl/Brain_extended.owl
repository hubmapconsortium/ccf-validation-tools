    <!-- http://purl.obolibrary.org/obo/UBERON_0004086 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004086">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000955"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One of the system of communicating cavities in the brain that are continuous with the central canal of the spinal cord, that like it are derived from the medullary canal of the embryo, that are lined with an epithelial ependyma, and that contain a serous fluid.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Organ cavity of the brain which consists of the lateral ventricles, the third and fourth ventricles and the cerebral aqueduct[BIRNLEX:1356].</obo:UBPROP_0000001>
        <obo:UBPROP_0000012 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA draws the distinction between e.g. &apos;fourth ventricle&apos; and &apos;cavity of fourth ventricle&apos;. The latter is a cavity, and part of the former, which is a region. The superclass of &apos;fourth ventricle&apos; is_a &apos;region of ventricular system of the brain&apos;. We place this class here, although it is not equivalent to ventricles, as it includes ventricle bodies.</obo:UBPROP_0000012>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BIRNLEX:1356</oboInOwl:hasDbXref>
