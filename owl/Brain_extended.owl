        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">subcallosal gyrus (parolfactory gyrus)</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/4/4d/Gray732.png</foaf:depiction>
