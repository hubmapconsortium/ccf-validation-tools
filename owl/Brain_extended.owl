    <!-- http://purl.obolibrary.org/obo/PCL_0010063 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/PCL_0010063">
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/CLM_0010001"/>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/pcl.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">obsolete some_soma_located_in</rdfs:label>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">some_soma_located_in</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
