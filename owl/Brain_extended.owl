    <!-- http://purl.obolibrary.org/obo/CL_4030048 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4030048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_1001474"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002131"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005382"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A DRD1-expressing medium spiny neuron that is part of a striosome of dorsal striatum.</obo:IAO_0000115>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-06-02T14:50:43+00:00</terms:date>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">striosome D1 medium spiny neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D1-striosome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D1S</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">striosome D1-MSN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In Rhesus macaques, both striosomal D1 and D2 medium spiny neuron (MSN) cell types have been noted to have enriched gene expression of the following: KCNT1, KHDRBS3, FAM163A, BACH2, and KCNIP1. Striosomal MSN activations have been noted to influence cognitive and emotional decision making and value-based learning. In contrast to matrix MSNs, striosomal MSNs receive input from limbic territories, including the anterior cingulate cortex, orbitofrontal cortex, and anterior insular cortex, and project directly to midbrain dopamine neurons.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/cl.owl"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">striosomal D1 medium spiny neuron</rdfs:label>
        <skos:prefLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">STRd D1 Striosome MSN</skos:prefLabel>
    </owl:Class>
