        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">According to spatial transcriptomic data in the human striatum, pthlh-expressing interneurons are one of the most abundant population of interneurons in the striatum (Leonardo D. Garma, et al., 2024).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/cl.owl"/>
        <rdfs:label xml:lang="en">striatal pthlh-expressing interneuron</rdfs:label>
